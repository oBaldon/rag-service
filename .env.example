# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Schema no qual as tabelas e demais objetos da aplicação são criados.
PG_SCHEMA=intelireg

# Banco esperado pelo reset_db.sh; impede apagar acidentalmente outro banco.
PG_EXPECTED_DB=intelireg
# Use 1 somente para permitir reset mesmo quando o banco não for o esperado.
ALLOW_RESET_ANY_DB=0

# Conexão usada pela aplicação e pelas migrations.
DATABASE_URL=postgresql://intelireg:CHANGE_ME@localhost:5432/intelireg
# Conexão privilegiada usada apenas para operações como CREATE EXTENSION.
PG_SUPERUSER_URL=postgresql://postgres:CHANGE_ME@localhost:5432/intelireg

# -----------------------------------------------------------------------------
# Runtime e autenticação
# -----------------------------------------------------------------------------
# Permite importar o pacote intelireg diretamente a partir de src/.
PYTHONPATH=src
# Chave compartilhada esperada pela API quando a autenticação estiver ativa.
RAG_API_KEY="CHANGE_ME"

# -----------------------------------------------------------------------------
# Embeddings e execução local
# -----------------------------------------------------------------------------
# GPU CUDA visível para o processo; use vazio para forçar execução apenas em CPU.
CUDA_VISIBLE_DEVICES=0
# Evita paralelismo excessivo e avisos da biblioteca tokenizers.
TOKENIZERS_PARALLELISM=false
# Token de leitura do Hugging Face para baixar modelos sem limites anônimos.
HF_TOKEN=CHANGE_ME

# Ambiente de execução da aplicação.
APP_ENV=local
# Em produção, use true para exigir RAG_API_KEY nas requisições.
RAG_AUTH_REQUIRED=false

# Versão lógica do pipeline registrada nas execuções.
PIPELINE_VERSION=mvp-v1
# Modelo de embeddings e dimensão esperada pelo schema vetorial.
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small@384
EMBEDDING_DIMENSION=384

# Coleta web: timeout e retentativas para rede, HTTP 429 e HTTP 5xx.
INGEST_HTTP_TIMEOUT_SECONDS=30
INGEST_HTTP_MAX_ATTEMPTS=3
INGEST_HTTP_BACKOFF_SECONDS=2
INGEST_HTTP_MAX_BACKOFF_SECONDS=60
# Intervalo preventivo entre URLs no script batch.
INGEST_REQUEST_DELAY_SECONDS=1
# O batch termina todo o trabalho e retorna 2 se alguma URL falhar.
FAIL_ON_INGEST_ERRORS=1
# Caminho opcional; se omitido, cada execução cria um nome único em storage/logs/.
# INGEST_FAILURE_LOG=storage/logs/ingest_failures.jsonl

# -----------------------------------------------------------------------------
# Limites da API
# -----------------------------------------------------------------------------
# Tamanho máximo da pergunta, em caracteres.
QUESTION_MAX_LENGTH=10000
# Máximo de candidatos considerados durante a recuperação.
RETRIEVAL_CANDIDATES_MAX=200
# Maior constante k aceita pelo algoritmo Reciprocal Rank Fusion (RRF).
RRF_K_MAX=500
# Máximo de resultados finais que uma consulta pode solicitar.
TOP_K_MAX=50
# Tamanho máximo do identificador de uma requisição, em caracteres.
REQUEST_ID_MAX_LENGTH=128
