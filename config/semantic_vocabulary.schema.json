{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InteliReg Semantic Vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vocabulary_version",
    "language",
    "concepts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "vocabulary_version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "aliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "query_expansions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "embedding_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
