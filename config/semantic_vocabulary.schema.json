{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InteliReg Semantic Vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vocabulary_version",
    "language",
    "sources",
    "concepts"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "vocabulary_version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "url",
          "retrieved_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "priority",
          "aliases",
          "domains",
          "regulatory_processes",
          "parent_concepts",
          "related_concepts",
          "source_refs",
          "governance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "query_expansions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "embedding_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            }
          },
          "regulatory_processes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "registro_medicamento",
                "pos_registro",
                "afe",
                "cbpf",
                "pesquisa_clinica",
                "transversal"
              ]
            }
          },
          "parent_concepts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            }
          },
          "related_concepts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
            },
            "minItems": 1
          },
          "governance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lifecycle",
              "review_status",
              "owner_role",
              "change_ref"
            ],
            "properties": {
              "lifecycle": {
                "enum": [
                  "active",
                  "deprecated"
                ]
              },
              "review_status": {
                "enum": [
                  "pending_domain_review",
                  "approved",
                  "rejected"
                ]
              },
              "owner_role": {
                "type": "string",
                "minLength": 1
              },
              "reviewer_role": {
                "type": "string"
              },
              "reviewed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "change_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
